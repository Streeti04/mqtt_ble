# MQTT-Zugangsdaten fuer opt/mqtt_ble (basic_mqtt, observe_bleak, goove_mqtt_bridge, monitor_mqtt)
# Kopieren nach mqtt.env (gitignored) und Werte eintragen:
#   cp mqtt.env.example mqtt.env && chmod 600 mqtt.env
# Umgebungsvariablen gleichen Namens haben Vorrang vor dieser Datei.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USER=CHANGE_ME
MQTT_PASSWORD=CHANGE_ME
